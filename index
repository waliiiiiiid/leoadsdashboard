<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Leo Ads — Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
:root{--bg:#0a0a0f;--s1:#12121a;--s2:#1a1a26;--br:rgba(255,255,255,.07);--br2:rgba(255,255,255,.13);--tx:#f0eff8;--mu:#6b6a80;--gn:#00d9a3;--am:#f5a623;--rd:#ff4d6d;--pu:#6c63ff}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--tx);font-family:'DM Mono',monospace;font-size:13px;min-height:100vh}
/* HEADER */
.hdr{display:flex;align-items:center;justify-content:space-between;padding:1rem 2rem;border-bottom:1px solid var(--br);position:sticky;top:0;z-index:50;background:rgba(10,10,15,.96);backdrop-filter:blur(10px);flex-wrap:wrap;gap:8px}
.logo{display:flex;align-items:center;gap:10px}
.lmk{width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,#6c63ff,#00d9a3);display:flex;align-items:center;justify-content:center;font-family:'Syne',sans-serif;font-weight:800;font-size:14px;color:#fff}
.ltx{font-family:'Syne',sans-serif;font-weight:700;font-size:16px;letter-spacing:-.02em}
.ltx span{color:var(--gn)}
.hr{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.spl{display:flex;align-items:center;gap:5px;padding:5px 10px;border-radius:20px;border:1px solid var(--br2);font-size:11px;color:var(--mu);background:var(--s1)}
.sd{width:7px;height:7px;border-radius:50%;background:var(--am);animation:pl 2s infinite}
.sd.ok{background:var(--gn);animation:none}.sd.er{background:var(--rd);animation:none}
@keyframes pl{0%,100%{opacity:1}50%{opacity:.3}}
.btn{padding:6px 13px;border-radius:7px;background:var(--s2);border:1px solid var(--br2);color:var(--tx);font-family:'DM Mono',monospace;font-size:12px;cursor:pointer;transition:all .15s}
.btn:hover{border-color:var(--gn);color:var(--gn)}
.lu{font-size:11px;color:var(--mu)}
/* DATE BAR */
.db{display:flex;align-items:flex-end;gap:12px;padding:.8rem 2rem;border-bottom:1px solid var(--br);flex-wrap:wrap;background:rgba(18,18,26,.9)}
.dg{display:flex;flex-direction:column;gap:3px}
.dl{font-size:10px;color:var(--mu);text-transform:uppercase;letter-spacing:.06em}
input[type=date]{background:var(--s2);border:1px solid var(--br2);color:var(--tx);padding:7px 11px;border-radius:8px;font-family:'DM Mono',monospace;font-size:12px;cursor:pointer;outline:none;color-scheme:dark;min-width:145px;transition:border-color .15s}
input[type=date]:hover,input[type=date]:focus{border-color:var(--gn)}
.ds{color:var(--mu);font-size:15px;padding-bottom:4px}
.qbs{display:flex;gap:5px;flex-wrap:wrap;align-self:flex-end}
.qb{padding:6px 11px;border-radius:6px;background:transparent;border:1px solid var(--br2);color:var(--mu);font-family:'DM Mono',monospace;font-size:11px;cursor:pointer;white-space:nowrap;transition:all .15s}
.qb:hover{border-color:var(--gn);color:var(--gn)}
.qb.on{border-color:var(--gn);color:var(--gn);background:rgba(0,217,163,.07)}
.rb{display:flex;align-items:center;gap:5px;padding:6px 11px;border-radius:8px;background:rgba(0,217,163,.07);border:1px solid rgba(0,217,163,.17);font-size:11px;color:var(--gn);white-space:nowrap;align-self:flex-end}
/* MAIN */
.mn{padding:1.4rem 2rem;max-width:1400px;margin:0 auto}
.tbar{display:flex;gap:1px;margin-bottom:1.4rem;border-bottom:1px solid var(--br)}
.tab{padding:9px 17px;cursor:pointer;font-family:'Syne',sans-serif;font-size:13px;font-weight:500;color:var(--mu);border-bottom:2px solid transparent;margin-bottom:-1px;transition:all .15s;white-space:nowrap}
.tab:hover{color:var(--tx)}.tab.on{color:var(--gn);border-bottom-color:var(--gn)}
/* METRICS */
.mr{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:1.3rem}
.mc{background:var(--s1);border:1px solid var(--br);border-radius:11px;padding:1rem 1.2rem;position:relative;overflow:hidden}
.mc::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--ac,var(--pu));opacity:.65}
.ml{font-size:10px;color:var(--mu);text-transform:uppercase;letter-spacing:.07em;margin-bottom:7px}
.mv{font-family:'Syne',sans-serif;font-size:21px;font-weight:700;line-height:1}
.mv.g{color:var(--gn)}.mv.w{color:var(--am)}.mv.r{color:var(--rd)}
.ms{font-size:10px;color:var(--mu);margin-top:4px}
/* CARDS */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:1.3rem;margin-bottom:1.3rem}
.cd{background:var(--s1);border:1px solid var(--br);border-radius:12px;padding:1.3rem}
.ct{font-family:'Syne',sans-serif;font-weight:600;font-size:13px;color:var(--tx);margin-bottom:1rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:6px}
.cb{font-size:10px;padding:2px 7px;border-radius:4px;background:var(--s2);color:var(--mu)}
.cw{position:relative;width:100%;height:200px}
/* TABLE */
.tw{overflow-x:auto}
table{width:100%;border-collapse:collapse}
th{font-size:10px;text-transform:uppercase;letter-spacing:.07em;color:var(--mu);padding:8px 10px;text-align:left;border-bottom:1px solid var(--br);font-weight:400}
td{padding:8px 10px;border-bottom:1px solid var(--br);font-size:12px}
tr:last-child td{border-bottom:none}
tr:hover td{background:rgba(255,255,255,.02)}
.bc{display:flex;align-items:center;gap:6px;font-family:'Syne',sans-serif;font-weight:600;font-size:12px}
.bd{width:7px;height:7px;border-radius:50%}
.bge{display:inline-block;padding:2px 7px;border-radius:5px;font-size:11px;font-weight:500}
.bg{background:rgba(0,217,163,.12);color:var(--gn);border:1px solid rgba(0,217,163,.2)}
.bw{background:rgba(245,166,35,.12);color:var(--am);border:1px solid rgba(245,166,35,.2)}
.bb{background:rgba(255,77,109,.12);color:var(--rd);border:1px solid rgba(255,77,109,.2)}
/* BRAND CARDS */
.bcs{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:1.1rem}
.bc2{background:var(--s1);border:1px solid var(--br);border-radius:12px;padding:1.3rem;position:relative;overflow:hidden}
.bc2::after{content:'';position:absolute;top:0;right:0;width:65px;height:65px;border-radius:0 12px 0 65px;background:var(--bc);opacity:.07}
.bch{display:flex;align-items:center;gap:9px;margin-bottom:1rem}
.bav{width:35px;height:35px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-family:'Syne',sans-serif;font-weight:800;font-size:13px}
.bn{font-family:'Syne',sans-serif;font-weight:700;font-size:14px}
.bsb{font-size:10px;color:var(--mu);margin-top:1px}
.bsg{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.bs{background:var(--s2);border-radius:7px;padding:8px 10px}
.bsl{font-size:9px;text-transform:uppercase;letter-spacing:.07em;color:var(--mu);margin-bottom:3px}
.bsv{font-family:'Syne',sans-serif;font-weight:700;font-size:15px}
/* SPEND TAB */
.sg{display:grid;grid-template-columns:repeat(5,1fr);gap:9px;margin-bottom:1rem}
.sw{display:flex;flex-direction:column;gap:3px}
.swl{font-size:10px;color:var(--mu);text-transform:uppercase;letter-spacing:.06em}
.sdi{position:relative}
.sdi::before{content:'$';position:absolute;left:8px;top:50%;transform:translateY(-50%);color:var(--mu);font-size:12px;pointer-events:none}
.si{width:100%;background:var(--s2);border:1px solid var(--br2);color:var(--tx);padding:7px 9px 7px 20px;border-radius:8px;font-family:'DM Mono',monospace;font-size:12px;outline:none;transition:border-color .15s}
.si:focus{border-color:var(--gn)}
/* LOADER */
.ov{position:fixed;inset:0;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:999;gap:14px}
.ld{width:36px;height:36px;border-radius:50%;border:2px solid var(--br2);border-top-color:var(--gn);animation:sp .8s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}
.lt{font-family:'Syne',sans-serif;font-size:13px;color:var(--mu)}
.tc{display:none}.tc.on{display:block}
.em{text-align:center;padding:2.5rem;color:var(--mu);font-size:12px}
@media(max-width:900px){.mr{grid-template-columns:repeat(2,1fr)}.g2{grid-template-columns:1fr}.mn,.hdr,.db{padding:1rem}.sg{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.mr{grid-template-columns:1fr 1fr}.bcs{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="ov" id="ov"><div class="ld"></div><div class="lt" id="lt">Connexion aux sheets…</div></div>

<div class="hdr">
  <div class="logo"><div class="lmk">L</div><div class="ltx">Leo <span>Ads</span></div></div>
  <div class="hr">
    <div class="spl"><div class="sd" id="sd"></div><span id="st">Chargement…</span></div>
    <span class="lu" id="lu"></span>
    <button class="btn" onclick="init()">↻ Actualiser</button>
  </div>
</div>

<div class="db">
  <div class="dg"><div class="dl">Du</div><input type="date" id="d1" value="2026-03-02" onchange="onDC()"></div>
  <div class="ds">→</div>
  <div class="dg"><div class="dl">Au</div><input type="date" id="d2" value="2026-12-27" onchange="onDC()"></div>
  <div class="qbs">
    <button class="qb on" onclick="qr('all',this)">Tout 2026</button>
    <button class="qb" onclick="qr('q2',this)">Q2</button>
    <button class="qb" onclick="qr('q3',this)">Q3</button>
    <button class="qb" onclick="qr('q4',this)">Q4</button>
    <button class="qb" onclick="qr('month',this)">Ce mois</button>
    <button class="qb" onclick="qr('4w',this)">4 semaines</button>
  </div>
  <div class="rb">◈ <span id="rl">Mars → Déc 2026</span></div>
</div>

<div class="mn">
  <div class="tbar">
    <div class="tab on" onclick="stab('ov2',this)">Vue globale</div>
    <div class="tab" onclick="stab('br',this)">Par marque</div>
    <div class="tab" onclick="stab('wk',this)">Hebdomadaire</div>
    <div class="tab" onclick="stab('sp',this)">Suivi Spend</div>
  </div>

  <div class="tc on" id="tab-ov2">
    <div class="mr" id="gm"></div>
    <div class="g2" style="margin-bottom:1.3rem">
      <div class="cd"><div class="ct">Spend vs CA <span class="cb" id="b1">période</span></div><div class="cw"><canvas id="c1"></canvas></div></div>
      <div class="cd"><div class="ct">ROAS <span class="cb">par marque</span></div><div class="cw"><canvas id="c2"></canvas></div></div>
    </div>
    <div class="cd">
      <div class="ct">Récap <span class="cb" id="b2">2026</span></div>
      <div class="tw"><table><thead><tr><th>Marque</th><th>Spend</th><th>CA</th><th>Ventes</th><th>Prix/vente</th><th>CA/vente</th><th>ROAS</th><th>Profit net</th></tr></thead><tbody id="tb1"></tbody></table></div>
    </div>
  </div>

  <div class="tc" id="tab-br"><div class="bcs" id="bcs"></div></div>

  <div class="tc" id="tab-wk">
    <div class="cd">
      <div class="ct">Hebdomadaire
        <select id="fb" onchange="rWk()" style="background:var(--s2);border:1px solid var(--br2);color:var(--tx);padding:6px 10px;border-radius:7px;font-family:'DM Mono',monospace;font-size:12px;outline:none;cursor:pointer">
          <option value="">Toutes</option>
          <option>Delta Funded</option><option>VTPF</option><option>Leodas</option><option>Matei FX</option><option>Davy Passing</option>
        </select>
      </div>
      <div class="tw"><table><thead><tr><th>Semaine</th><th>Marque</th><th>Spend</th><th>CA</th><th>Ventes</th><th>Prix/vente</th><th>CA/vente</th><th>ROAS</th><th>Profit</th></tr></thead><tbody id="tb2"></tbody></table></div>
    </div>
  </div>

  <div class="tc" id="tab-sp">
    <div class="cd" style="margin-bottom:1.3rem">
      <div class="ct">Saisie Spend Meta
        <div style="display:flex;align-items:center;gap:8px">
          <span id="sm" style="font-size:11px;color:var(--gn)"></span>
          <button class="btn" onclick="svSp()" style="border-color:var(--gn);color:var(--gn)">+ Enregistrer</button>
        </div>
      </div>
      <div style="margin-bottom:1rem">
        <div class="dl" style="margin-bottom:5px">Semaine</div>
        <select id="sw" onchange="ldWk(this.value)" style="background:var(--s2);border:1px solid var(--br2);color:var(--tx);padding:7px 11px;border-radius:8px;font-family:'DM Mono',monospace;font-size:12px;outline:none;cursor:pointer;max-width:280px"></select>
      </div>
      <div class="sg" id="sg"></div>
      <div style="background:var(--s2);border-radius:7px;padding:8px 12px;font-size:11px;color:var(--mu)">Données sauvegardées localement et fusionnées avec les sheets.</div>
    </div>
    <div class="cd">
      <div class="ct">Historique <span class="cb" id="sc">0</span></div>
      <div class="tw"><table><thead><tr><th>Semaine</th><th>Delta</th><th>VTPF</th><th>Leodas</th><th>Matei FX</th><th>Davy</th><th>Total</th><th></th></tr></thead><tbody id="tb3"></tbody></table></div>
    </div>
  </div>
</div>

<script>
// ─────────────────────────────────────────────
// CONFIG
// ─────────────────────────────────────────────
const BR = ['Delta Funded','VTPF','Leodas','Matei FX','Davy Passing'];
const IDS = {
  'Delta Funded':'1KmbPYf8ndMGjsXhNLHZNjjJQdJQWwF12putAMBp0YPg',
  'VTPF':        '1omEcgv6TuNOBp1CxPp1TAkYOJqa97bf8SybeIbq-9X8',
  'Leodas':      '1t5SdniuceKIGfvGmE_oHuHnfVVWKQ6xjaHUgMQ-ewnQ',
  'Matei FX':    '1GonnOSZoKlu9_p9Kkc9sZ7eAfiJFOPeDtfHP0r2wOao',
  'Davy Passing':'1YcEhe24A7YY7BJbw4H8mc25sr2E581C4_SeLg4vQHi0',
};
const MB = '1FqPr6ecDZn1WxPwviBzAcH6IG1OKDC-hBD07PNs2nMM';
const CL = {'Delta Funded':'#4d9fff','VTPF':'#00d9a3','Leodas':'#ff7043','Matei FX':'#f5a623','Davy Passing':'#b39dff'};
const MN = ['Jan','Fév','Mar','Avr','Mai','Jun','Jul','Aoû','Sep','Oct','Nov','Déc'];
const MM = {jan:0,fév:1,fev:1,feb:1,mar:2,avr:3,apr:3,mai:4,may:4,jun:5,jul:6,aoû:7,aou:7,aug:7,sep:8,oct:9,nov:10,déc:11,dec:11};

// ─────────────────────────────────────────────
// STATE
// ─────────────────────────────────────────────
let DATA = {sp:{}, br:{}};
let CH = {};

// ─────────────────────────────────────────────
// UTILS
// ─────────────────────────────────────────────
// Convertit n'importe quelle valeur gviz en nombre
function N(v) {
  if (v === null || v === undefined || v === '' || v === '-') return 0;
  if (typeof v === 'number') return isNaN(v) ? 0 : v;
  // Retire tout sauf chiffres, point, virgule, moins
  let s = String(v).replace(/[$\s\u00a0\u202f\u2009\u2060]/g, '');
  s = s.replace(/[^0-9.,-]/g, '');
  if (!s) return 0;
  // Virgule décimale FR "1234,56" → "1234.56"
  if (/,\d{1,2}$/.test(s)) s = s.replace(',', '.');
  else s = s.replace(/,/g, ''); // virgule milliers
  return parseFloat(s) || 0;
}

// Valeur numérique d'une cellule gviz — v en priorité, f en fallback
function CV(cell) {
  if (!cell) return 0;
  if (typeof cell.v === 'number' && !isNaN(cell.v)) return cell.v;
  if (cell.v !== null && cell.v !== undefined && cell.v !== '') return N(cell.v);
  if (cell.f) return N(cell.f);
  return 0;
}

const $f = n => n === null || isNaN(n) ? '—' : '$' + Math.round(n).toLocaleString('fr-FR');
const $x = n => !n || !isFinite(n) ? '—' : n.toFixed(2) + 'x';
const rb = r => !r || !isFinite(r) ? '<span class="bge bw">—</span>' : `<span class="bge ${r>=3?'bg':r>=1.5?'bw':'bb'}">${r.toFixed(2)}x</span>`;

// Convertit une cellule gviz en clé "YYYY-MM-DD" (lundi de la semaine)
function toKey(cell) {
  if (!cell) return null;
  const v = cell.v, f = cell.f || '';

  // Date JS
  if (v instanceof Date) return dk(v);

  // "Date(2026,2,2)"
  if (typeof v === 'string' && v.startsWith('Date(')) {
    const m = v.match(/Date\((\d+),(\d+),(\d+)\)/);
    if (m) return dk(new Date(+m[1], +m[2], +m[3]));
  }

  // Numéro série Excel
  if (typeof v === 'number' && v > 40000 && v < 70000)
    return dk(new Date(Date.UTC(1899, 11, 30) + v * 864e5));

  // Texte — essaie v puis f
  const txt = (typeof v === 'string' && v.length > 3) ? v : (f.length > 3 ? f : '');
  return txt ? kFromText(txt) : null;
}

function dk(d) {
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}

function kFromText(raw) {
  const s = raw.replace(/[\u2013\u2014]/g, '-').replace(/[\u00a0\u202f]/g, ' ').trim();
  if (!s || ['TOTAL','GRAND','▸','◆','★','Semaine'].some(x => s.includes(x))) return null;
  const parts = s.split(/\s*-\s*/);
  if (parts.length < 2) return null;
  const sp = parts[0].trim().split(/\s+/);
  const ep = parts[parts.length - 1].trim().split(/\s+/);
  const yr = parseInt(ep[ep.length - 1]);
  if (isNaN(yr) || yr < 2020 || yr > 2030) return null;
  const dy = parseInt(sp[0]);
  const mo = sp[1] ? MM[sp[1].toLowerCase().substring(0, 3)] : undefined;
  if (isNaN(dy) || mo === undefined) return null;
  return dk(new Date(yr, mo, dy));
}

function skip(cell) {
  if (!cell) return true;
  const s = String(cell.v ?? cell.f ?? '').trim();
  if (!s || s === '0' || s === 'null') return true;
  if (['TOTAL','GRAND','▸','◆','★','Semaine','semaine','CA (','Nb v','Prix','ROAS'].some(x => s.includes(x))) return true;
  // Doit avoir un tiret ou être une date sérialisée
  const hasDash = s.includes('-') || s.includes('–');
  const isDate = (cell.v instanceof Date) || (typeof cell.v === 'string' && cell.v.startsWith('Date(')) || (typeof cell.v === 'number' && cell.v > 40000 && cell.v < 70000);
  return !hasDash && !isDate;
}

// ─────────────────────────────────────────────
// FETCH — gviz JSON (fonctionne CORS depuis file://)
// ─────────────────────────────────────────────
async function gviz(id, sheet) {
  const url = `https://docs.google.com/spreadsheets/d/${id}/gviz/tq?tqx=out:json&sheet=${encodeURIComponent(sheet)}&headers=1`;
  const r = await fetch(url, { mode: 'cors' });
  const txt = await r.text();
  const m = txt.match(/google\.visualization\.Query\.setResponse\(([\s\S]+)\)\s*;?\s*$/);
  if (!m) throw new Error('gviz parse failed for ' + id);
  const d = JSON.parse(m[1]);
  if (d.status === 'error') throw new Error(d.errors?.[0]?.message || 'gviz error');
  return d.table;
}

// ─────────────────────────────────────────────
// PARSE SHEET MARQUE
// ─────────────────────────────────────────────
function parseBrand(tbl) {
  if (!tbl || !tbl.rows) return [];
  const out = [];
  for (const row of tbl.rows) {
    if (!row.c || !row.c[0]) continue;
    if (skip(row.c[0])) continue;
    const key = toKey(row.c[0]);
    if (!key) continue;
    const lbl = String(row.c[0].f || row.c[0].v || '');
    // Lit c.v directement — c'est la valeur brute numérique
    out.push({
      key,
      lbl,
      ca:    CV(row.c[1]),
      sales: CV(row.c[2]),
      price: CV(row.c[3]),
    });
  }
  return out;
}

// ─────────────────────────────────────────────
// PARSE SHEET MEDIA BUYER
// ─────────────────────────────────────────────
function parseMB(tbl) {
  if (!tbl || !tbl.rows) return {};
  const out = {};
  for (const row of tbl.rows) {
    if (!row.c || !row.c[0]) continue;
    if (skip(row.c[0])) continue;
    const key = toKey(row.c[0]);
    if (!key) continue;
    out[key] = {
      'Delta Funded': CV(row.c[1]),
      'VTPF':         CV(row.c[2]),
      'Leodas':       CV(row.c[3]),
      'Matei FX':     CV(row.c[4]),
      'Davy Passing': CV(row.c[5]),
    };
  }
  return out;
}

// ─────────────────────────────────────────────
// LOAD ALL
// ─────────────────────────────────────────────
async function init() {
  setS('', 'Actualisation…');
  document.getElementById('lt').textContent = 'Connexion aux sheets…';
  try {
    const [mb, ...brs] = await Promise.all([
      gviz(MB, 'Spend Meta'),
      ...BR.map(b => gviz(IDS[b], 'CA + Ventes'))
    ]);
    DATA.sp = parseMB(mb);
    BR.forEach((b, i) => { DATA.br[b] = parseBrand(brs[i]); });
    mergeLoc();
    render();
    document.getElementById('lu').textContent = 'Mis à jour ' + new Date().toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
    setS('ok', 'Données live');
  } catch(e) {
    console.error(e);
    setS('er', 'Erreur — ' + e.message);
    mergeLoc();
    render();
  }
  document.getElementById('ov').style.display = 'none';
}

// ─────────────────────────────────────────────
// DATE RANGE
// ─────────────────────────────────────────────
function getDR() {
  return {
    from: new Date(document.getElementById('d1').value || '2026-01-01'),
    to:   new Date((document.getElementById('d2').value || '2026-12-31') + 'T23:59:59'),
  };
}
function inR(key, f, t) {
  if (!key) return true;
  const d = new Date(key), de = new Date(key);
  de.setDate(de.getDate() + 6);
  return de >= f && d <= t;
}
function qr(k, el) {
  const t = new Date(), y = t.getFullYear();
  let f, to;
  if (k==='all'){f='2026-03-02';to='2026-12-27';}
  else if(k==='q2'){f='2026-04-01';to='2026-06-30';}
  else if(k==='q3'){f='2026-07-01';to='2026-09-30';}
  else if(k==='q4'){f='2026-10-01';to='2026-12-31';}
  else if(k==='month'){const m=String(t.getMonth()+1).padStart(2,'0'),ld=new Date(y,t.getMonth()+1,0).getDate();f=`${y}-${m}-01`;to=`${y}-${m}-${ld}`;}
  else if(k==='4w'){const d4=new Date(t);d4.setDate(d4.getDate()-28);f=d4.toISOString().split('T')[0];to=t.toISOString().split('T')[0];}
  document.getElementById('d1').value=f;
  document.getElementById('d2').value=to;
  document.querySelectorAll('.qb').forEach(b=>b.classList.remove('on'));
  el.classList.add('on');
  updLbl(); render();
}
function onDC(){document.querySelectorAll('.qb').forEach(b=>b.classList.remove('on'));updLbl();render();}
function updLbl(){
  const f=document.getElementById('d1').value,t=document.getElementById('d2').value;
  if(!f||!t){document.getElementById('rl').textContent='Toute la période';return;}
  const fd=new Date(f),td=new Date(t);
  const fmt=d=>`${d.getDate()} ${MN[d.getMonth()]} ${d.getFullYear()}`;
  document.getElementById('rl').textContent=`${fmt(fd)} → ${fmt(td)}`;
}

// ─────────────────────────────────────────────
// COMPUTE STATS
// ─────────────────────────────────────────────
function stats() {
  const {from, to} = getDR();
  return BR.map(brand => {
    const rows = (DATA.br[brand] || []).filter(r => inR(r.key, from, to));
    let sp=0, ca=0, sl=0, ps=0, pc=0;
    for (const r of rows) {
      ca += r.ca; sl += r.sales;
      if (r.price > 0) { ps += r.price; pc++; }
      const sw = DATA.sp[r.key];
      if (sw) sp += sw[brand] || 0;
    }
    return {brand, sp, ca, sl, ap:pc>0?ps/pc:0, as:sl>0?ca/sl:0, roas:sp>0?ca/sp:null, pr:ca-sp, ac:rows.filter(r=>r.ca>0||r.sl>0).length};
  });
}

// ─────────────────────────────────────────────
// RENDER
// ─────────────────────────────────────────────
function render() {
  const s = stats();
  updBdg(); rMet(s); rCh(s); rTb(s); rBr(s); rWk();
}

function updBdg(){
  const {from,to}=getDR();
  const fmt=d=>`${d.getDate()} ${MN[d.getMonth()]}`;
  const l=`${fmt(from)} → ${fmt(to)}`;
  document.getElementById('b1').textContent=l;
  document.getElementById('b2').textContent=l;
}

function rMet(s){
  const tSp=s.reduce((a,x)=>a+x.sp,0),tCA=s.reduce((a,x)=>a+x.ca,0);
  const tSl=s.reduce((a,x)=>a+x.sl,0),gR=tSp>0?tCA/tSp:null,tPr=tCA-tSp;
  const rc=r=>!r||!isFinite(r)?'':r>=3?'g':r>=1.5?'w':'r';
  document.getElementById('gm').innerHTML=`
    <div class="mc" style="--ac:var(--pu)"><div class="ml">Spend total</div><div class="mv">${$f(tSp)}</div><div class="ms">Meta Ads</div></div>
    <div class="mc" style="--ac:var(--gn)"><div class="ml">CA total</div><div class="mv g">${$f(tCA)}</div><div class="ms">5 marques</div></div>
    <div class="mc" style="--ac:var(--am)"><div class="ml">ROAS global</div><div class="mv ${rc(gR)}">${$x(gR)}</div><div class="ms">CA ÷ Spend</div></div>
    <div class="mc" style="--ac:#b39dff"><div class="ml">Ventes</div><div class="mv">${tSl.toLocaleString('fr-FR')}</div><div class="ms">totales</div></div>
    <div class="mc" style="--ac:var(--gn)"><div class="ml">Profit net</div><div class="mv ${tPr>=0?'g':'r'}">${$f(tPr)}</div><div class="ms">CA − Spend</div></div>`;
}

function rCh(s){
  if(CH.b)CH.b.destroy(); if(CH.r)CH.r.destroy();
  CH.b=new Chart(document.getElementById('c1'),{type:'bar',data:{labels:s.map(x=>x.brand),datasets:[
    {label:'Spend',data:s.map(x=>x.sp),backgroundColor:BR.map(b=>CL[b]+'44'),borderColor:BR.map(b=>CL[b]),borderWidth:1.5,borderRadius:4},
    {label:'CA',   data:s.map(x=>x.ca),backgroundColor:BR.map(b=>CL[b]+'99'),borderColor:BR.map(b=>CL[b]),borderWidth:1.5,borderRadius:4},
  ]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>' '+c.dataset.label+': $'+Math.round(c.raw).toLocaleString('fr-FR')}}},scales:{y:{ticks:{color:'#6b6a80',font:{size:10},callback:v=>'$'+Math.round(v/1000)+'k'},grid:{color:'rgba(255,255,255,0.04)'},border:{display:false}},x:{ticks:{color:'#6b6a80',font:{size:10,family:'Syne'}},grid:{display:false},border:{display:false}}}}});
  const rv=s.map(x=>x.roas?+x.roas.toFixed(2):0);
  CH.r=new Chart(document.getElementById('c2'),{type:'bar',data:{labels:s.map(x=>x.brand),datasets:[{data:rv,backgroundColor:rv.map(r=>r>=3?'#00d9a344':r>=1.5?'#f5a62344':'#ff4d6d44'),borderColor:rv.map(r=>r>=3?'#00d9a3':r>=1.5?'#f5a623':'#ff4d6d'),borderWidth:1.5,borderRadius:4}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>` ROAS: ${c.raw.toFixed(2)}x`}}},scales:{y:{ticks:{color:'#6b6a80',font:{size:10},callback:v=>v.toFixed(1)+'x'},grid:{color:'rgba(255,255,255,0.04)'},border:{display:false},min:0},x:{ticks:{color:'#6b6a80',font:{size:10,family:'Syne'}},grid:{display:false},border:{display:false}}}}});
}

function rTb(s){
  document.getElementById('tb1').innerHTML=s.map(x=>`<tr>
    <td><div class="bc"><div class="bd" style="background:${CL[x.brand]}"></div>${x.brand}</div></td>
    <td>${$f(x.sp)}</td><td style="color:var(--gn)">${$f(x.ca)}</td>
    <td>${x.sl.toLocaleString('fr-FR')}</td>
    <td>${x.ap>0?$f(x.ap):'—'}</td><td>${x.as>0?$f(x.as):'—'}</td>
    <td>${rb(x.roas)}</td>
    <td style="color:${x.pr>=0?'var(--gn)':'var(--rd)'};font-weight:500">${$f(x.pr)}</td>
  </tr>`).join('');
}

function rBr(s){
  document.getElementById('bcs').innerHTML=s.map(x=>{
    const ini=x.brand.split(' ').map(w=>w[0]).join('').substring(0,2);
    const rc=x.roas?(x.roas>=3?'var(--gn)':x.roas>=1.5?'var(--am)':'var(--rd)'):'var(--mu)';
    return`<div class="bc2" style="--bc:${CL[x.brand]}">
      <div class="bch">
        <div class="bav" style="background:${CL[x.brand]}22;border:1px solid ${CL[x.brand]}44"><span style="color:${CL[x.brand]}">${ini}</span></div>
        <div><div class="bn">${x.brand}</div><div class="bsb">${x.ac} sem. active${x.ac!==1?'s':''}</div></div>
      </div>
      <div class="bsg">
        <div class="bs"><div class="bsl">Spend</div><div class="bsv">${$f(x.sp)}</div></div>
        <div class="bs"><div class="bsl">CA</div><div class="bsv" style="color:var(--gn)">${$f(x.ca)}</div></div>
        <div class="bs"><div class="bsl">Ventes</div><div class="bsv">${x.sl.toLocaleString('fr-FR')}</div></div>
        <div class="bs"><div class="bsl">ROAS</div><div class="bsv" style="color:${rc}">${$x(x.roas)}</div></div>
        <div class="bs"><div class="bsl">Prix/vente moy.</div><div class="bsv">${x.ap>0?$f(x.ap):'—'}</div></div>
        <div class="bs"><div class="bsl">Profit net</div><div class="bsv" style="color:${x.pr>=0?'var(--gn)':'var(--rd)'}">${$f(x.pr)}</div></div>
      </div>
    </div>`;
  }).join('');
}

function rWk(){
  const {from,to}=getDR(), fb=document.getElementById('fb').value, rows=[];
  for(const b of BR){
    if(fb&&b!==fb) continue;
    for(const r of(DATA.br[b]||[])){
      if(!inR(r.key,from,to)) continue;
      if(r.ca===0&&r.sales===0&&r.price===0) continue;
      const sp=(DATA.sp[r.key]||{})[b]||0;
      rows.push({...r,brand:b,sp,roas:sp>0?r.ca/sp:null,pr:r.ca-sp});
    }
  }
  rows.sort((a,b)=>a.key.localeCompare(b.key));
  document.getElementById('tb2').innerHTML=!rows.length
    ?`<tr><td colspan="9"><div class="em">Aucune donnée pour cette période.</div></td></tr>`
    :rows.map(r=>`<tr>
      <td style="font-size:11px;color:var(--mu)">${r.lbl||r.key}</td>
      <td><div class="bc"><div class="bd" style="background:${CL[r.brand]}"></div>${r.brand}</div></td>
      <td>${$f(r.sp)}</td><td style="color:var(--gn)">${$f(r.ca)}</td>
      <td>${r.sales||'—'}</td><td>${r.price>0?$f(r.price):'—'}</td>
      <td>${r.sales>0?$f(r.ca/r.sales):'—'}</td>
      <td>${rb(r.roas)}</td>
      <td style="color:${r.pr>=0?'var(--gn)':'var(--rd)'}">${$f(r.pr)}</td>
    </tr>`).join('');
}

// ─────────────────────────────────────────────
// TABS & STATUS
// ─────────────────────────────────────────────
function stab(n,el){
  document.querySelectorAll('.tc').forEach(t=>t.classList.remove('on'));
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('on'));
  document.getElementById('tab-'+n).classList.add('on'); el.classList.add('on');
}
function setS(st,msg){
  document.getElementById('sd').className='sd'+(st==='ok'?' ok':st==='er'?' er':'');
  document.getElementById('st').textContent=msg;
}

// ─────────────────────────────────────────────
// SPEND LOCAL (localStorage)
// ─────────────────────────────────────────────
const SK='leo_sp_v3';
const lsL=()=>{try{return JSON.parse(localStorage.getItem(SK)||'{}')}catch{return{}}};
const lsS=d=>localStorage.setItem(SK,JSON.stringify(d));

function genWks(){
  const wks=[],end=new Date(2026,11,27);
  let d=new Date(2026,2,2);
  while(d<=end){
    const s=new Date(d); s.setDate(s.getDate()+6);
    const fmt=x=>`${String(x.getDate()).padStart(2,'0')} ${MN[x.getMonth()]}`;
    wks.push({key:dk(d),lbl:`${fmt(d)} – ${fmt(s)} ${s.getFullYear()}`});
    d.setDate(d.getDate()+7);
  }
  return wks;
}

function initSp(){
  const wks=genWks();
  const sel=document.getElementById('sw');
  sel.innerHTML=wks.map(w=>`<option value="${w.key}">${w.lbl}</option>`).join('');
  const today=dk(new Date());
  const best=wks.reduce((a,b)=>Math.abs(new Date(b.key)-new Date(today))<Math.abs(new Date(a.key)-new Date(today))?b:a);
  sel.value=best.key;
  document.getElementById('sg').innerHTML=BR.map(b=>`
    <div class="sw">
      <div class="swl">${b}</div>
      <div class="sdi"><input class="si" type="number" id="si-${b.replace(/\s/g,'_')}" min="0" step="0.01" placeholder="0.00"></div>
    </div>`).join('');
  ldWk(sel.value); rSpH();
}

function ldWk(key){
  const e=lsL()[key]||{};
  BR.forEach(b=>{const i=document.getElementById('si-'+b.replace(/\s/g,'_'));if(i)i.value=e[b]||'';});
}
function svSp(){
  const key=document.getElementById('sw').value, d=lsL(), e={};
  BR.forEach(b=>{const i=document.getElementById('si-'+b.replace(/\s/g,'_'));e[b]=i?parseFloat(i.value)||0:0;});
  d[key]=e; lsS(d); DATA.sp[key]=e; rSpH(); render();
  const m=document.getElementById('sm'); m.textContent='Enregistré !'; setTimeout(()=>m.textContent='',2500);
}
function delSp(k){const d=lsL();delete d[k];delete DATA.sp[k];lsS(d);rSpH();render();}
function rSpH(){
  const d=lsL(),wks=genWks();
  const es=Object.entries(d).filter(([,v])=>Object.values(v).some(x=>x>0)).sort((a,b)=>b[0].localeCompare(a[0]));
  document.getElementById('sc').textContent=`${es.length} entrée${es.length!==1?'s':''}`;
  const tb=document.getElementById('tb3');
  if(!es.length){tb.innerHTML=`<tr><td colspan="8"><div class="em">Aucune saisie.</div></td></tr>`;return;}
  tb.innerHTML=es.map(([k,v])=>{
    const w=wks.find(x=>x.key===k);
    const tot=BR.reduce((s,b)=>s+(v[b]||0),0);
    return`<tr>
      <td style="font-size:11px">${w?w.lbl:k}</td>
      ${BR.map(b=>`<td>${v[b]>0?'$'+v[b].toLocaleString('fr-FR',{minimumFractionDigits:0,maximumFractionDigits:2}):'—'}</td>`).join('')}
      <td style="color:var(--gn);font-weight:500">$${tot.toLocaleString('fr-FR',{maximumFractionDigits:2})}</td>
      <td><button onclick="delSp('${k}')" style="background:transparent;border:1px solid var(--br2);color:var(--mu);padding:3px 7px;border-radius:5px;cursor:pointer;font-size:10px">✕</button></td>
    </tr>`;
  }).join('');
}
function mergeLoc(){
  const d=lsL();
  Object.entries(d).forEach(([k,v])=>{
    if(!DATA.sp[k])DATA.sp[k]={};
    BR.forEach(b=>{if(v[b])DATA.sp[k][b]=v[b];});
  });
}

// ─────────────────────────────────────────────
// BOOT
// ─────────────────────────────────────────────
updLbl();
initSp();
init();
</script>
